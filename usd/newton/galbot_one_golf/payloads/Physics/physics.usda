                            quatf physics:principalAxes = (1, 0, 0, 0)

                            over "wheel_4_passive_9_collision" (
                                prepend apiSchemas = ["NewtonCollisionAPI", "PhysicsMassAPI"]
                            )
                            {
                                float newton:contactGap = 0
                                float physics:density = 1000
                            }

                            def PhysicsRevoluteJoint "wheel_4_passive_9_joint" (
                                prepend apiSchemas = ["PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
                            )
                            {
                                uniform token physics:axis = "Z"
                                custom rel physics:body0
                                prepend rel physics:body0 = </galbot_one_golf/Geometry/base_footprint/base_link/omni_chassis_base_link/wheel_4>
                                custom rel physics:body1
                                prepend rel physics:body1 = </galbot_one_golf/Geometry/base_footprint/base_link/omni_chassis_base_link/wheel_4/wheel_4_passive_9>
                                point3f physics:localPos0 = (0, 0.06472136, -0.04702282)
                                point3f physics:localPos1 = (0, 0, 0)
                                quatf physics:localRot0 = (0.95105654, -0.3090169, 1.3877788e-17, -5.551115e-17)
                                quatf physics:localRot1 = (1, 0, 0, 0)
                            }
                        }

                        def PhysicsRevoluteJoint "wheel4_joint" (
                            prepend apiSchemas = ["PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
                        )
                        {
                            float drive:angular:physics:damping = 50
                            float drive:angular:physics:maxForce = 120
                            float drive:angular:physics:stiffness = 0
                            uniform token physics:axis = "X"
                            custom rel physics:body0
                            prepend rel physics:body0 = </galbot_one_golf/Geometry/base_footprint/base_link/omni_chassis_base_link>
                            custom rel physics:body1
                            prepend rel physics:body1 = </galbot_one_golf/Geometry/base_footprint/base_link/omni_chassis_base_link/wheel_4>
                            point3f physics:localPos0 = (0.176493, -0.176493, 0.071834)
                            point3f physics:localPos1 = (0, 0, 0)
                            quatf physics:localRot0 = (0.3826903, 0, 0, 0.9238767)
                            quatf physics:localRot1 = (1, 0, 0, 0)
                        }
                    }

                    over "chassis_lidar" (
                        prepend apiSchemas = ["PhysicsRigidBodyAPI"]
                    )
                    {
                        def PhysicsFixedJoint "PhysicsFixedJoint"
                        {
                            custom rel physics:body0
                            prepend rel physics:body0 = </galbot_one_golf/Geometry/base_footprint/base_link/omni_chassis_base_link>
                            custom rel physics:body1
                            prepend rel physics:body1 = </galbot_one_golf/Geometry/base_footprint/base_link/omni_chassis_base_link/chassis_lidar>
                            point3f physics:localPos0 = (0.235, 0, 0.2144)
                            point3f physics:localPos1 = (0, 0, 0)
                            quatf physics:localRot0 = (1, 0, 0, 0)
                            quatf physics:localRot1 = (1, 0, 0, 0)
                        }
                    }

                    def PhysicsFixedJoint "PhysicsFixedJoint"
                    {
                        custom rel physics:body0
                        prepend rel physics:body0 = </galbot_one_golf/Geometry/base_footprint/base_link>
                        custom rel physics:body1
                        prepend rel physics:body1 = </galbot_one_golf/Geometry/base_footprint/base_link/omni_chassis_base_link>
                        point3f physics:localPos0 = (0, 0, 0)
                        point3f physics:localPos1 = (0, 0, 0)
                        quatf physics:localRot0 = (1, 0, 0, 0)
                        quatf physics:localRot1 = (1, 0, 0, 0)
                    }
                }

                def PhysicsFixedJoint "PhysicsFixedJoint"
                {
                    custom rel physics:body0
                    prepend rel physics:body0 = </galbot_one_golf/Geometry/base_footprint>
                    custom rel physics:body1
                    prepend rel physics:body1 = </galbot_one_golf/Geometry/base_footprint/base_link>
                    point3f physics:localPos0 = (0, 0, 0.028166)
                    point3f physics:localPos1 = (0, 0, 0)
                    quatf physics:localRot0 = (1, 0, 0, 0)
                    quatf physics:localRot1 = (1, 0, 0, 0)
                }
            }
        }
    }

    over "Physics"
    {
        over "PhysicsMaterial" (
            prepend apiSchemas = ["PhysicsMaterialAPI", "NewtonMaterialAPI"]
        )
        {
            float newton:rollingFriction = 0.001
            float newton:torsionalFriction = 0.02
            float physics:dynamicFriction = 0.8
        }

        over "PhysicsMaterial_1" (
            prepend apiSchemas = ["PhysicsMaterialAPI", "NewtonMaterialAPI"]
        )
        {
            float newton:rollingFriction = 0.0001
            float newton:torsionalFriction = 0.005
            float physics:dynamicFriction = 1
        }

        over "PhysicsMaterial_2" (
            prepend apiSchemas = ["PhysicsMaterialAPI", "NewtonMaterialAPI"]
        )
        {
            float newton:rollingFriction = 0.001
            float newton:torsionalFriction = 0.02
            float physics:dynamicFriction = 1.2
        }
    }
}

